---
import DraftContentNotice from "virtual:starlight/components/DraftContentNotice";
import HomePage from "./home/HomePage.astro";

const PAGE_TITLE_ID = "_top";
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const formatLink = (url: string) => {
  if (url.startsWith("/")) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    return `${base}${url}`;
  }

  return url;
};
---

<section class="course-hero" aria-labelledby={PAGE_TITLE_ID}>
  <div class="course-hero__glow" aria-hidden="true"></div>
  <div class="course-hero__content">
    <p class="course-hero__eyebrow">
      <span aria-hidden="true"></span>TypeScript Guidebook
    </p>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {data.draft && <DraftContentNotice />}
    {tagline && <p class="course-hero__tagline" set:html={tagline} />}
    <p class="course-hero__reassurance">
      Tidak perlu pengalaman programming sebelumnya.
    </p>
    {
      actions.length > 0 && (
        <div class="course-hero__actions">
          {actions.map(({ link: href, text, variant }) => (
            <a
              href={formatLink(href)}
              class:list={[
                "course-hero__button",
                variant === "primary"
                  ? "course-hero__button--primary"
                  : "course-hero__button--secondary",
              ]}
            >
              <span>{text}</span>
              {variant === "primary" && (
                <span class="course-hero__arrow" aria-hidden="true">
                  →
                </span>
              )}
            </a>
          ))}
        </div>
      )
    }
    <ul class="course-hero__proof" aria-label="Ringkasan guidebook">
      <li><strong>13</strong> Bab</li>
      <li><strong>SMK</strong> RPL</li>
      <li><strong>ID</strong> Bahasa Indonesia</li>
    </ul>
  </div>
</section>

<HomePage />

<style>
  .course-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 6.5rem) 1rem clamp(3rem, 7vw, 5.5rem);
    text-align: center;
  }
  .course-hero__glow {
    position: absolute;
    z-index: -1;
    width: min(42rem, 100vw);
    aspect-ratio: 1;
    top: -65%;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--sod-accent) 18%, transparent) 0%,
      transparent 68%
    );
    pointer-events: none;
  }
  .course-hero__content {
    max-width: 48rem;
    margin-inline: auto;
  }
  .course-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.42rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--sod-accent) 26%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sod-accent) 7%, transparent);
    color: var(--sod-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }
  .course-hero__eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sod-accent);
    box-shadow: 0 0 0 0.25rem
      color-mix(in srgb, var(--sod-accent) 16%, transparent);
  }
  .course-hero h1 {
    max-width: 13ch;
    margin: 0 auto;
    background: var(--sod-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(2.65rem, 8vw, 5.5rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .course-hero__tagline {
    max-width: 58ch;
    margin: 1.5rem auto 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
  }
  .course-hero__reassurance {
    margin: 0.85rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
  }
  .course-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .course-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.9rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform var(--sod-transition),
      border-color var(--sod-transition),
      box-shadow var(--sod-transition);
  }
  .course-hero__button:hover {
    transform: translateY(-2px);
  }
  .course-hero__button--primary {
    background: var(--sod-gradient);
    box-shadow: 0 10px 22px
      color-mix(in srgb, var(--sod-accent) 24%, transparent);
    color: #fff;
  }
  .course-hero__button--secondary {
    border-color: var(--sod-border-strong);
    background: var(--sod-surface);
    color: var(--sl-color-white);
  }
  .course-hero__button--secondary:hover {
    border-color: var(--sod-accent);
  }
  .course-hero__arrow {
    font-size: 1.15em;
    transition: transform var(--sod-transition);
  }
  .course-hero__button--primary:hover .course-hero__arrow {
    transform: translateX(0.2rem);
  }
  .course-hero__proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin: 1.7rem 0 0;
    padding: 0;
    list-style: none;
  }
  .course-hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--sod-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sod-surface) 78%, transparent);
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
  }
  .course-hero__proof strong {
    color: var(--sl-color-white);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  @media (max-width: 25rem) {
    .course-hero__actions {
      display: grid;
    }
    .course-hero__button {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .course-hero__button,
    .course-hero__arrow {
      transition: none;
    }
  }

  .course-hero #_top {
    line-height: normal !important;
  }
</style>
