---
/**
 * Custom Hero component — HTML Guidebook
 * Redesigned: Robust responsive layout (Desktop 2-col, Tablet compact, Mobile single-col),
 * zero horizontal overflow, fluid typography, and authentic code editor aesthetic.
 */
import DraftContentNotice from "virtual:starlight/components/DraftContentNotice";
import { getCollection } from "astro:content";

const PAGE_TITLE_ID = "_top";

const { data } = Astro.locals.starlightRoute.entry;
const docs = await getCollection("docs");
const chapterCount = new Set(
  docs
    .map((entry) => entry.id.match(/^bab(\d+)\//)?.[1])
    .filter((chapter): chapter is string => chapter !== undefined),
).size;
const miniProjectCount = docs.filter((entry) =>
  /^bab12\/project-/.test(entry.id),
).length;

const formatLink = (url: string) => {
  if (url.startsWith("/")) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    return `${base}${url}`;
  }
  return url;
};
---

<section class="hero-section" aria-labelledby={PAGE_TITLE_ID}>
  <div class="hero-bg-glow" aria-hidden="true"></div>

  <div class="hp-container hero-grid">
    {/* Left Column: Editorial Headline, Tagline, Actions, Meta */}
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          HTML5 Guidebook &middot; Bahasa Indonesia
        </span>
      </div>

      <h1 id={PAGE_TITLE_ID} data-page-title class="hero-title">
        Bangun Fondasi Web <span class="text-accent">dengan HTML</span>
      </h1>

      {data.draft && <DraftContentNotice />}

      <p class="hero-desc">
        Kurikulum HTML terstruktur untuk siswa SMK RPL dan pemula web
        development. Mulai dari konsep dasar, semantic tags, forms,
        accessibility, hingga membangun website nyata.
      </p>

      <div class="hero-actions" role="group" aria-label="Mulai belajar">
        <a href={formatLink("/bab0/introduction/")} class="btn btn-primary">
          <span>Mulai Belajar</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="btn-icon"
            aria-hidden="true"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
        <a href="#roadmap" class="btn btn-secondary"> Lihat Roadmap </a>
      </div>

      {/* Supporting meta proofs */}
      <div class="hero-meta-row" role="list" aria-label="Ringkasan fitur">
        <div class="hero-meta-item" role="listitem">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="meta-icon"
            aria-hidden="true"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          <span>{chapterCount} Bab Lengkap (BAB 00–15)</span>
        </div>
        <div class="hero-meta-item" role="listitem">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="meta-icon"
            aria-hidden="true"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          <span>{miniProjectCount} Mini Project &amp; 1 Final Project</span>
        </div>
      </div>
    </div>

    {/* Right Column: Interactive Code Environment Window */}
    <div class="hero-visual" aria-hidden="true">
      <div class="code-window">
        {/* Top titlebar */}
        <div class="window-header">
          <div class="window-controls">
            <span class="ctrl-dot dot-red"></span>
            <span class="ctrl-dot dot-yellow"></span>
            <span class="ctrl-dot dot-green"></span>
          </div>
          <div class="window-tab">
            <svg
              class="file-icon"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path><polyline points="14 2 14 8 20 8"></polyline><line
                x1="16"
                y1="13"
                x2="8"
                y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
              ></line><polyline points="10 9 9 9 8 9"></polyline></svg
            >
            <span>index.html</span>
          </div>
          <div class="window-lang">HTML5</div>
        </div>

        {/* Code Content */}
        <div class="code-body">
          <pre
            class="code-content"><code><span class="c-dim">&lt;!DOCTYPE html&gt;</span>
<span class="c-tag">&lt;html</span> <span class="c-attr">lang</span>=<span class="c-str">"id"</span><span class="c-tag">&gt;</span>
  <span class="c-tag">&lt;head&gt;</span>
    <span class="c-tag">&lt;meta</span> <span class="c-attr">charset</span>=<span class="c-str">"UTF-8"</span><span class="c-tag">&gt;</span>
    <span class="c-tag">&lt;title&gt;</span>HTML Guidebook<span class="c-tag">&lt;/title&gt;</span>
  <span class="c-tag">&lt;/head&gt;</span>
  <span class="c-tag">&lt;body&gt;</span>
    <span class="c-tag">&lt;header&gt;</span>
      <span class="c-tag">&lt;nav&gt;</span>
        <span class="c-tag">&lt;a</span> <span class="c-attr">href</span>=<span class="c-str">"/"</span><span class="c-tag">&gt;</span>Beranda<span class="c-tag">&lt;/a&gt;</span>
        <span class="c-tag">&lt;a</span> <span class="c-attr">href</span>=<span class="c-str">"/materi"</span><span class="c-tag">&gt;</span>Materi<span class="c-tag">&lt;/a&gt;</span>
      <span class="c-tag">&lt;/nav&gt;</span>
    <span class="c-tag">&lt;/header&gt;</span>
    <span class="c-tag">&lt;main&gt;</span>
      <span class="c-tag">&lt;article&gt;</span>
        <span class="c-tag">&lt;h1&gt;</span>Semantic HTML5<span class="c-tag">&lt;/h1&gt;</span>
        <span class="c-tag">&lt;p&gt;</span>Fondasi web modern &amp; accessible.<span class="c-tag">&lt;/p&gt;</span>
      <span class="c-tag">&lt;/article&gt;</span>
    <span class="c-tag">&lt;/main&gt;</span>
  <span class="c-tag">&lt;/body&gt;</span>
<span class="c-tag">&lt;/html&gt;</span></code></pre>
        </div>

        {/* Window Footer Status bar */}
        <div class="window-footer">
          <div class="status-item">
            <span class="status-indicator"></span>
            <span>Semantic DOM &bull; W3C Valid</span>
          </div>
          <div class="status-meta">UTF-8 &bull; 16 Lines</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════
   HERO SECTION — Premium Developer Aesthetic & Responsive Layout
   ═══════════════════════════════════════════════════════════════ */
  .hero-section {
    position: relative;
    overflow: hidden;
    padding: clamp(2.25rem, 4.5vw, 4rem) 0 clamp(2rem, 3.5vw, 3.25rem);
    width: 100%;
  }

  .hero-bg-glow {
    position: absolute;
    top: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: min(1100px, 130%);
    height: 480px;
    background: radial-gradient(
      ellipse 60% 50% at 50% 0%,
      var(--hp-accent-glow),
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 4vw, 3.75rem);
    align-items: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  /* Left Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    min-width: 0;
    max-width: 100%;
    width: 100%;
  }

  .hero-badge-wrap {
    margin-bottom: clamp(0.75rem, 1.5vw, 1.125rem);
    max-width: 100%;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sl-font-mono);
    font-size: clamp(0.625rem, 2.2vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--sod-accent);
    background: var(--hp-accent-soft);
    border: 1px solid var(--hp-accent-border);
    border-radius: 99px;
    padding: 0.25rem clamp(0.5rem, 2vw, 0.75rem);
    max-width: 100%;
    box-sizing: border-box;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sod-accent);
    box-shadow: 0 0 6px var(--sod-accent);
    flex-shrink: 0;
  }

  .hero-title {
    font-size: clamp(1.85rem, 3.8vw + 0.4rem, 3.125rem) !important;
    font-weight: 800 !important;
    line-height: 1.14 !important;
    letter-spacing: -0.035em !important;
    color: var(--sod-text) !important;
    margin: 0 0 clamp(0.75rem, 1.5vw, 1.125rem) 0 !important;
    word-break: normal;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  .text-accent {
    color: var(--sod-accent);
  }

  .hero-desc {
    font-size: clamp(0.875rem, 1vw + 0.45rem, 1.05rem);
    line-height: 1.65;
    color: var(--sod-text-2);
    max-width: 48ch;
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem) 0;
  }

  /* Buttons container */
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  /* Meta proofs row */
  .hero-meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sod-border);
    width: 100%;
    max-width: 440px;
    min-width: 0;
  }

  .hero-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sod-text-muted);
    line-height: 1.4;
    min-width: 0;
    max-width: 100%;
  }

  .meta-icon {
    color: #22c55e;
    flex-shrink: 0;
  }

  /* Right Column: Code Window */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .code-window {
    width: 100%;
    max-width: 480px;
    min-width: 0;
    background: #0d1117;
    border: 1px solid var(--sod-border-strong);
    border-radius: var(--sod-radius-lg);
    box-shadow:
      0 16px 36px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .window-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--sod-border);
    flex-shrink: 0;
  }

  .window-controls {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .ctrl-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot-red {
    background: #ef4444;
  }
  .dot-yellow {
    background: #eab308;
  }
  .dot-green {
    background: #22c55e;
  }

  .window-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--sod-border);
    border-radius: 4px;
    padding: 0.15rem 0.55rem;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--sod-text-2);
  }

  .file-icon {
    color: var(--sod-accent);
  }

  .window-lang {
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    color: var(--sod-text-muted);
    font-weight: 600;
  }

  .code-body {
    padding: 0.85rem 1rem;
    background: rgba(0, 0, 0, 0.25);
    overflow-x: auto;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .code-content {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: clamp(0.6875rem, 0.9vw + 0.35rem, 0.775rem);
    line-height: 1.5;
    background: transparent;
    color: #e2e8f0;
    white-space: pre;
    tab-size: 2;
    word-break: normal;
    overflow-wrap: normal;
    min-width: 0;
    max-width: 100%;
  }

  .c-dim {
    color: #64748b;
    font-style: italic;
  }
  .c-tag {
    color: #ff5533;
    font-weight: 600;
  }
  .c-attr {
    color: #ff8a3d;
  }
  .c-str {
    color: #86efac;
  }

  .window-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px solid var(--sod-border);
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    color: var(--sod-text-muted);
    flex-shrink: 0;
  }

  .status-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  /* Light Theme Code Window Overrides */
  [data-theme="light"] .code-window {
    background: #181b20;
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow:
      0 16px 36px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.04);
  }

  [data-theme="light"] .window-header {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.08);
  }

  [data-theme="light"] .window-tab {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    color: #f1f5f9;
  }

  [data-theme="light"] .window-lang {
    color: #94a3b8;
  }

  [data-theme="light"] .code-body {
    background: rgba(0, 0, 0, 0.2);
  }

  [data-theme="light"] .code-content {
    color: #f8fafc;
  }

  [data-theme="light"] .c-dim {
    color: #94a3b8;
  }
  [data-theme="light"] .c-tag {
    color: #ff6b4a;
  }
  [data-theme="light"] .c-attr {
    color: #fb923c;
  }
  [data-theme="light"] .c-str {
    color: #86efac;
  }

  [data-theme="light"] .window-footer {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
  }

  /* ═══════════════════════════════════════════════════════════════
   RESPONSIVE BREAKPOINTS
   ═══════════════════════════════════════════════════════════════ */

  /* Tablet Landscape / Small Laptop (992px - 1199px) */
  @media (min-width: 62rem) and (max-width: 74.9375rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2rem;
    }

    .hero-title {
      font-size: clamp(2rem, 3.2vw, 2.65rem) !important;
    }

    .code-window {
      max-width: 440px;
    }
  }

  /* Tablet Portrait & Medium Screens (< 992px) */
  @media (max-width: 61.9375rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .hero-desc {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-meta-row {
      align-items: center;
      margin-inline: auto;
    }

    .code-window {
      max-width: 500px;
    }
  }

  /* Mobile Screens (<= 767px) */
  @media (max-width: 47.9375rem) {
    .hero-section {
      padding: clamp(1.5rem, 4vw, 2.25rem) 0 clamp(1.5rem, 3.5vw, 2rem);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .hero-title {
      font-size: clamp(1.65rem, 6.5vw, 2.25rem) !important;
      line-height: 1.16 !important;
    }

    .hero-desc {
      font-size: 0.9rem;
      line-height: 1.55;
      margin-bottom: 1.25rem;
    }

    .hero-actions {
      gap: 0.625rem;
      margin-bottom: 1.25rem;
    }

    .hero-meta-row {
      padding-top: 0.85rem;
      gap: 0.35rem;
    }

    .hero-meta-item {
      font-size: 0.775rem;
    }

    .code-window {
      max-width: 100%;
      border-radius: var(--sod-radius);
    }

    .code-body {
      padding: 0.65rem 0.75rem;
    }

    .code-content {
      font-size: 0.6875rem;
      line-height: 1.42;
    }
  }

  /* Extra small mobile (<= 480px / 320px) */
  @media (max-width: 30rem) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }

  /* Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-section,
    .hero-grid,
    .hero-actions .btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
