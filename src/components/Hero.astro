---
/**
 * Custom Hero component — SmartOneDev HTML Guidebook
 * Two-column desktop layout featuring a browser mockup that demonstrates
 * the compiling of semantic HTML code into a rendered web page structure.
 */
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';

const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const formatLink = (url: string) => {
  if (url.startsWith('/')) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    return `${base}${url}`;
  }
  return url;
};
---

<section class="hero-section-custom" aria-labelledby={PAGE_TITLE_ID}>
  <div class="hero-bg-glow" aria-hidden="true"></div>
  
  <div class="hero-container-custom">
    {/* Left Column: Content */}
    <div class="hero-content-custom">
      <div class="hero-badge-wrap">
        <span class="hero-badge-tag">&lt;HTML GUIDEBOOK /&gt;</span>
      </div>
      
      <h1 id={PAGE_TITLE_ID} data-page-title class="hero-headline-custom" set:html={title} />
      
      {data.draft && <DraftContentNotice />}
      
      {tagline && <p class="hero-tagline-custom" set:html={tagline} />}
      
      {actions.length > 0 && (
        <div class="hero-actions-custom" role="group" aria-label="Mulai belajar">
          {actions.map(({ link: href, text, variant }) => (
            <a
              href={formatLink(href)}
              class:list={['hero-btn-custom', variant === 'primary' ? 'btn-primary' : 'btn-secondary']}
            >
              {text}
              {variant === 'primary' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow-custom" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              )}
            </a>
          ))}
        </div>
      )}
      
      {/* Proof / stat row */}
      <div class="hero-stats-custom" role="list" aria-label="Ringkasan kurikulum">
        <div class="stat-item-custom" role="listitem">
          <span class="stat-value">16</span>
          <span class="stat-label">Bab Materi</span>
        </div>
        <span class="stat-sep" aria-hidden="true"></span>
        <div class="stat-item-custom" role="listitem">
          <span class="stat-value">Mini</span>
          <span class="stat-label">Projects</span>
        </div>
        <span class="stat-sep" aria-hidden="true"></span>
        <div class="stat-item-custom" role="listitem">
          <span class="stat-value">Challenges</span>
          <span class="stat-label">Latihan</span>
        </div>
        <span class="stat-sep" aria-hidden="true"></span>
        <div class="stat-item-custom" role="listitem">
          <span class="stat-value">HTML</span>
          <span class="stat-label">Reference</span>
        </div>
      </div>
    </div>
    
    {/* Right Column: HTML Compilation Browser Mockup */}
    <div class="hero-visual-custom" aria-hidden="true">
      <div class="browser-window">
        {/* Browser Top Bar */}
        <div class="browser-topbar">
          <div class="window-controls">
            <span class="ctrl-dot dot-red"></span>
            <span class="ctrl-dot dot-yellow"></span>
            <span class="ctrl-dot dot-green"></span>
          </div>
          <div class="browser-address">
            <svg class="lock-icon" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>localhost:3000/index.html</span>
          </div>
          <div class="window-actions">
            <span class="action-bar"></span>
            <span class="action-bar"></span>
          </div>
        </div>
        
        {/* Split Editor / Preview view */}
        <div class="browser-content">
          {/* Left Pane: Code Editor */}
          <div class="editor-pane">
            <div class="pane-header">
              <span>📄 index.html</span>
            </div>
            <pre class="code-view"><code><span class="c-tag">&lt;!DOCTYPE</span> <span class="c-attr">html</span><span class="c-tag">&gt;</span>
<span class="c-tag">&lt;html</span> <span class="c-attr">lang</span>=<span class="c-val">"id"</span><span class="c-tag">&gt;</span>
  <span class="c-tag">&lt;body&gt;</span>
    <span class="c-tag">&lt;header&gt;</span>
      <span class="c-tag">&lt;h1&gt;</span>Halo Dunia<span class="c-tag">&lt;/h1&gt;</span>
    <span class="c-tag">&lt;/header&gt;</span>
    <span class="c-tag">&lt;main&gt;</span>
      <span class="c-tag">&lt;article&gt;</span>
        <span class="c-tag">&lt;p&gt;</span>Belajar HTML...<span class="c-tag">&lt;/p&gt;</span>
      <span class="c-tag">&lt;/article&gt;</span>
    <span class="c-tag">&lt;/main&gt;</span>
  <span class="c-tag">&lt;/body&gt;</span>
<span class="c-tag">&lt;/html&gt;</span></code></pre>
          </div>
          
          {/* Divider with flow indicator */}
          <div class="split-divider">
            <div class="flow-arrow">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </div>
          </div>
          
          {/* Right Pane: Browser Render View */}
          <div class="render-pane">
            <div class="pane-header">
              <span>🖥️ Rendered View</span>
            </div>
            <div class="preview-layout">
              {/* Header Box */}
              <div class="rendered-block block-header">
                <span class="semantic-label">&lt;header&gt;</span>
                <div class="heading-line"></div>
              </div>
              
              {/* Main Box */}
              <div class="rendered-block block-main">
                <span class="semantic-label">&lt;main&gt;</span>
                
                {/* Article Box */}
                <div class="rendered-block block-article">
                  <span class="semantic-label">&lt;article&gt;</span>
                  <div class="text-line width-full"></div>
                  <div class="text-line width-medium"></div>
                  <div class="text-line width-short"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ═══════════════════════════════════════════════════════════
   HERO — Responsive Two-Column HTML Learning Theme
   ═══════════════════════════════════════════════════════════ */

.hero-section-custom {
  position: relative;
  overflow: hidden;
  padding: 5rem 1.5rem 4rem;
}

.hero-bg-glow {
  position: absolute;
  top: -10%;
  left: 50%;
  transform: translateX(-50%);
  width: min(900px, 120%);
  height: 500px;
  background: radial-gradient(ellipse 60% 55% at 50% 0%, rgba(255, 85, 51, 0.1), transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero-container-custom {
  position: relative;
  z-index: 1;
  max-width: 72rem;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: var(--hp-space-10, 4rem);
  align-items: center;
}

/* Left Content */
.hero-content-custom {
  text-align: left;
}

.hero-badge-wrap {
  margin-bottom: 1.5rem;
}

.hero-badge-tag {
  display: inline-block;
  font-family: var(--sl-font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--sod-accent);
  background: var(--hp-accent-soft, rgba(255, 85, 51, 0.08));
  border: 1px solid var(--hp-accent-border, rgba(255, 85, 51, 0.20));
  border-radius: 6px;
  padding: 0.35rem 0.75rem;
}

.hero-headline-custom {
  font-size: clamp(2.5rem, 5vw, 3.8rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--sod-text);
  margin: 0 0 1.25rem;
}

.hero-tagline-custom {
  font-size: clamp(1rem, 1.8vw, 1.1rem);
  line-height: 1.75;
  color: var(--sod-text-2);
  margin: 0 0 2.25rem;
  max-width: 48ch;
}

.hero-actions-custom {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 3.5rem;
}

.hero-btn-custom {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  border-radius: var(--sod-radius);
  padding: 0.75rem 1.625rem;
  font-size: 0.9375rem;
  font-weight: 600;
  line-height: 1;
  text-decoration: none !important;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  cursor: pointer;
}

.btn-primary {
  background: var(--sod-accent);
  color: #fff !important;
  box-shadow: 0 2px 12px rgba(255, 85, 51, 0.35);
}

.btn-primary:hover {
  background: #e63e1e;
  box-shadow: 0 4px 20px rgba(255, 85, 51, 0.5);
  transform: translateY(-1px);
}

.btn-primary:focus-visible {
  outline: 2px solid var(--sod-accent);
  outline-offset: 3px;
}

.btn-secondary {
  background: transparent;
  color: var(--sod-text) !important;
  border: 1px solid var(--sod-border-strong);
}

.btn-secondary:hover {
  border-color: var(--hp-accent-border, rgba(255, 85, 51, 0.2));
  color: var(--sod-accent) !important;
  background: var(--hp-accent-soft, rgba(255, 85, 51, 0.08));
}

.btn-secondary:focus-visible {
  outline: 2px solid var(--sod-accent);
  outline-offset: 3px;
}

.btn-arrow-custom {
  transition: transform 0.18s ease;
}

.btn-primary:hover .btn-arrow-custom {
  transform: translateX(3px);
}

/* Hero Stats */
.hero-stats-custom {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  padding-top: 2.25rem;
  border-top: 1px solid var(--sod-border);
}

.stat-item-custom {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.15rem;
}

.stat-value {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--sod-text);
  line-height: 1;
}

.stat-label {
  font-size: 0.72rem;
  color: var(--sod-text-muted);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.stat-sep {
  display: block;
  width: 1px;
  height: 2.25rem;
  background: var(--sod-border-strong);
  flex-shrink: 0;
}

/* Right Visual Mockup */
.hero-visual-custom {
  display: flex;
  justify-content: center;
  perspective: 1000px;
}

.browser-window {
  width: 100%;
  max-width: 500px;
  background: var(--sod-card, #16161b);
  border: 1px solid var(--sod-border-strong, rgba(255, 255, 255, 0.14));
  border-radius: 12px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Window Chrome */
.browser-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.65rem 1rem;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid var(--sod-border);
}

.window-controls {
  display: flex;
  gap: 6px;
}

.ctrl-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.dot-red    { background: #ef4444; }
.dot-yellow { background: #eab308; }
.dot-green  { background: #22c55e; }

.browser-address {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--sod-border);
  border-radius: 6px;
  padding: 0.25rem 1.5rem;
  font-family: var(--sl-font-mono);
  font-size: 0.65rem;
  color: var(--sod-text-muted);
}

.lock-icon {
  color: #22c55e;
}

.window-actions {
  display: flex;
  flex-direction: column;
  gap: 3px;
  width: 12px;
}

.action-bar {
  height: 2px;
  background: var(--sod-text-muted);
  border-radius: 1px;
  opacity: 0.6;
}

/* Window Content Areas */
.browser-content {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  background: rgba(0, 0, 0, 0.15);
  min-height: 280px;
}

.pane-header {
  padding: 0.4rem 0.75rem;
  background: rgba(0, 0, 0, 0.1);
  border-bottom: 1px solid var(--sod-border);
  font-family: var(--sl-font-mono);
  font-size: 0.65rem;
  color: var(--sod-text-muted);
  font-weight: 600;
}

.editor-pane {
  display: flex;
  flex-direction: column;
  border-right: 1px dashed var(--sod-border);
}

.code-view {
  margin: 0;
  padding: 1rem;
  font-family: var(--sl-font-mono);
  font-size: 0.7rem;
  line-height: 1.5;
  background: transparent;
  overflow-x: auto;
}

/* Custom code colors mapping to Starlight Expressive Code theme */
.c-tag  { color: #ff5533; font-weight: 600; }
.c-attr { color: #ff8a3d; }
.c-val  { color: #a8d8a8; }

.split-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 20px;
  background: rgba(255, 255, 255, 0.01);
}

.flow-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  background: var(--sod-card);
  border: 1px solid var(--hp-accent-border);
  border-radius: 50%;
  color: var(--sod-accent);
  box-shadow: 0 0 10px rgba(255, 85, 51, 0.2);
  z-index: 2;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.render-pane {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.015);
}

.preview-layout {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  height: 100%;
}

.rendered-block {
  border: 1px dashed var(--hp-accent-border);
  background: var(--hp-accent-glow);
  border-radius: 6px;
  padding: 0.5rem;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.semantic-label {
  position: absolute;
  top: -6px;
  right: 6px;
  font-family: var(--sl-font-mono);
  font-size: 0.55rem;
  font-weight: 700;
  color: var(--sod-accent);
  background: var(--sod-card);
  padding: 0 0.25rem;
  line-height: 1;
}

.heading-line {
  height: 6px;
  width: 60%;
  background: var(--sod-accent);
  border-radius: 3px;
  opacity: 0.85;
}

.block-main {
  flex: 1;
  border-color: rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.01);
}

.block-main > .semantic-label {
  color: var(--sod-text-muted);
}

.block-article {
  flex: 1;
  border-color: var(--hp-accent-border);
  background: var(--hp-accent-soft);
}

.text-line {
  height: 4px;
  background: var(--sod-text-2);
  border-radius: 2px;
  opacity: 0.35;
}

.width-full { width: 100%; }
.width-medium { width: 80%; }
.width-short { width: 50%; }

/* Responsive adjustments */
@media (max-width: 64rem) {
  .hero-container-custom {
    grid-template-columns: 1fr;
    gap: var(--hp-space-8, 3rem);
    text-align: center;
  }
  
  .hero-content-custom {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .hero-tagline-custom {
    margin-inline: auto;
  }
  
  .hero-actions-custom {
    justify-content: center;
  }
  
  .hero-stats-custom {
    justify-content: center;
    width: 100%;
  }
}

@media (max-width: 40rem) {
  .hero-section-custom {
    padding: 3rem 1.25rem 2rem;
  }
  
  .stat-sep {
    display: none;
  }
  
  .hero-stats-custom {
    gap: 1rem;
    justify-content: space-around;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-btn-custom { transition: none; }
  .btn-arrow-custom { transition: none; }
}

/* Light Theme tweaks */
[data-theme="light"] .browser-window {
  background: #ffffff;
  border-color: rgba(0, 0, 0, 0.1);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
}
[data-theme="light"] .browser-address {
  background: #f1f5f9;
  border-color: rgba(0, 0, 0, 0.08);
}
[data-theme="light"] .browser-content {
  background: #f8fafc;
}
[data-theme="light"] .pane-header {
  background: #f1f5f9;
  border-color: rgba(0, 0, 0, 0.08);
}
[data-theme="light"] .split-divider {
  background: #f8fafc;
}
[data-theme="light"] .flow-arrow {
  background: #ffffff;
}
[data-theme="light"] .editor-pane {
  border-right-color: rgba(0, 0, 0, 0.08);
}
[data-theme="light"] .c-tag {
  color: #e63e1e;
}
[data-theme="light"] .c-attr {
  color: #b45309;
}
[data-theme="light"] .c-val {
  color: #166534;
}
[data-theme="light"] .text-line {
  background: #0f172a;
}
[data-theme="light"] .block-main {
  border-color: rgba(0, 0, 0, 0.1);
  background: rgba(0, 0, 0, 0.01);
}
</style>
