---
/**
 * Hero.astro — Passthrough for CSS Guidebook home
 *
 * Starlight renders this inside .content-panel > .sl-container which
 * constrains width to 67.5rem. We cannot break out of that here.
 *
 * Strategy:
 *   - Render a visually hidden h1 so Starlight/SEO has a proper page title
 *   - The actual hero UI lives inside index.mdx under .home-page
 *   - .sl-container is reset to full-width in custom.css
 */
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title } = data.hero || {};
const PAGE_TITLE_ID = '_top';
---
<span id={PAGE_TITLE_ID} data-page-title aria-hidden="true" set:html={title} style="display:none;" />
