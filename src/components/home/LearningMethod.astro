---
import Icon, { type Props as IconProps } from '../ui/Icon.astro';

interface MethodStep {
  number: string;
  icon: IconProps['name'];
  title: string;
}

const steps: MethodStep[] = [
  { number: '01', icon: 'target', title: 'Tujuan Pembelajaran' },
  { number: '02', icon: 'book-open', title: 'Penjelasan Materi' },
  { number: '03', icon: 'lightbulb', title: 'Analogi Konseptual' },
  { number: '04', icon: 'terminal', title: 'Live Coding Interaktif' },
  { number: '05', icon: 'flask', title: 'Studi Kasus Nyata' },
  { number: '06', icon: 'trophy', title: 'Mini Project Mandiri' },
  { number: '07', icon: 'help-circle', title: 'Challenge & Latihan' },
  { number: '08', icon: 'alert-triangle', title: 'Error Corner' },
  { number: '09', icon: 'notebook-pen', title: 'Ringkasan Inti' },
];
---

<section class="learning-method" aria-labelledby="learning-method-title">
  <div class="learning-method__heading">
    <h2 id="learning-method-title" class="section-title">Metode Belajar yang Konsisten</h2>
    <p class="section-desc">
      Setiap bab mengikuti alur 9 langkah terstruktur, memastikan kamu tidak hanya membaca teori, tetapi juga membangun intuisi logika dan kemampuan problem solving praktis.
    </p>
  </div>

  <ol class="learning-method__steps">
    {
      steps.map(({ number, icon, title }) => (
        <li class="step-card">
          <span class="step-card__number">{number}</span>
          <div class="step-card__icon-box">
            <Icon name={icon} size={18} class="step-card__icon" />
          </div>
          <strong class="step-card__title">{title}</strong>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .learning-method {
    position: relative;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--sod-border);
    border-radius: var(--sod-radius-xl);
    background: var(--sod-surface);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
  }

  .learning-method__heading {
    max-width: 44rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--sod-accent) 26%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sod-accent) 7%, transparent);
    color: var(--sod-accent);
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .section-badge__icon {
    color: var(--sod-accent);
  }

  .section-title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .section-desc {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    line-height: 1.7;
  }

  .learning-method__steps {
    display: grid;
    gap: 0.85rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step-card {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.95rem;
    min-height: 3.8rem;
    padding: 0.85rem 1.15rem;
    border: 1px solid var(--sod-border);
    border-radius: var(--sod-radius);
    background: var(--sod-card);
    transition:
      transform var(--sod-transition),
      border-color var(--sod-transition),
      background-color var(--sod-transition),
      box-shadow var(--sod-transition);
  }

  .step-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--sod-accent) 40%, var(--sod-border));
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }

  .step-card__number {
    color: var(--sod-accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    font-family: var(--sl-font-mono);
    padding: 0.18rem 0.45rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--sod-accent) 10%, transparent);
  }

  .step-card__icon-box {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--sod-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sod-accent) 18%, transparent);
    color: var(--sod-accent);
  }

  .step-card__title {
    color: var(--sl-color-white);
    font-size: 0.94rem;
    font-weight: 650;
    line-height: 1.35;
  }

  @media (min-width: 44rem) {
    .learning-method__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .learning-method__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-card {
      transition: opacity 0.15s ease, border-color 0.15s ease, background-color 0.15s ease !important;
      transform: none !important;
    }
  }
</style>
